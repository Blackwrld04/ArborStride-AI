# ==============================================================================
# ArborStride AI - Environment Configuration & API Keys
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ------------------------------------------------------------------------------
# 1. Prior Labs TabPFN (Microclimate Heat Regression)
# ------------------------------------------------------------------------------
# TabPFN predicts road surface temperatures and canopy cooling deltas.
# If no key is provided, the local offline regression model is used.
TABPFN_API_KEY=your_tabpfn_api_key_here
TABPFN_MODEL_NAME=prior-labs/TabPFN-v2
TABPFN_DEVICE=cpu


# ------------------------------------------------------------------------------
# 2. Google Gemma 2 / Google AI (Naturalist Field Agent)
# ------------------------------------------------------------------------------
# Generates concise sensory waypoints and route naturalist briefings.
# Option A: Local Ollama running Gemma 2 (Default: zero-cost local inference)
GEMMA_MODEL_ENDPOINT=http://localhost:11434/api/generate
GEMMA_MODEL_TAG=gemma2:2b
GEMINI_API_KEY=your_gemini_api_key_here


# Option B: Google AI Studio API (Optional cloud alternative)
GOOGLE_API_KEY=

# ------------------------------------------------------------------------------
# 3. ElevenLabs (Neural Text-to-Speech Audio Cues)
# ------------------------------------------------------------------------------
# Synthesizes calm voice cues for hands-free Pocket Mode.
# If empty, the client browser automatically falls back to Web Speech API (free/offline).
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ------------------------------------------------------------------------------
# 4. Map & Weather APIs (No Keys Required)
# ------------------------------------------------------------------------------
# - CartoDB / OpenStreetMap / Esri: Free public tile layers pre-configured in Leaflet
# - Open-Meteo API: Free public solar radiation and weather forecast feed

